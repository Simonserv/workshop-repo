# =============================================================================
# .env.example — ENV CONTRACT (copy this to .env or .env.local, then fill in)
# =============================================================================
#
# This is the file YOU copy and paste your OWN Supabase keys into.
#
#   1. Copy this file to `.env.local`   (recommended for local dev)
#        - macOS/Linux:  cp .env.example .env.local
#        - Windows (PS):  Copy-Item .env.example .env.local
#   2. Open your Supabase project → Settings → API
#   3. Paste YOUR project's values below (replace the placeholders)
#   4. Set the SAME variables in your Vercel project (Settings → Environment
#      Variables) so your deployed site can reach your backend
#
# NEVER commit your filled-in .env / .env.local. They are gitignored on purpose.
# Only THIS .env.example (with placeholders, no real secrets) is committed.
#
# There are exactly THREE variables. Two are PUBLIC, one is SERVER-ONLY.
# -----------------------------------------------------------------------------


# --- PUBLIC (safe to ship to the browser) ------------------------------------
# These two are the ONLY variables that may carry the `NEXT_PUBLIC_` prefix.
# The prefix tells Next.js it is safe to include them in the client bundle.
# (Requirement 14.3)

# Your Supabase project URL. Public. Example: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Your Supabase anon (public) key. Public by design — Row Level Security, not
# secrecy, is what protects your data. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"


# --- SERVER-ONLY (must NEVER reach the browser) ------------------------------
# The service_role key bypasses Row Level Security and can read/write ANY row.
# It is read only inside server-only code (the few privileged admin writes).
#
# Do NOT give this a `NEXT_PUBLIC_` prefix. Doing so would bake the key into the
# client bundle and leak full admin access to every visitor. (Requirement 14.4)

SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
